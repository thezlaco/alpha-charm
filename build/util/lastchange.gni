# The revision this build is, written by tools/fetch-deps.sh.
#
# Chromium resolves this to LASTCHANGE for official builds and to
# LASTCHANGE.dummy for everything else, so that an unofficial build substitutes a
# fixed revision and produces the same binary from any checkout. That switch is
# gone: there is one file with the real revision in it, and the flag that chose
# between two of them would only point a build at a file that does not exist.
lastchange_file = "//build/util/LASTCHANGE"
